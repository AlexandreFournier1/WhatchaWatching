<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>whatchawatching-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhatchaWatching\WhatchaWatching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.MySql" Version="13.6.0" />
    <!-- Transitive versions with known vulnerabilities (GHSA-473q-m89c-ghf8, GHSA-qhrr-8q5h-9q3h): patched ones are pinned. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

</Project>
