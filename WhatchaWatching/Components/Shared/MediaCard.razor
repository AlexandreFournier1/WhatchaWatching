@inject ILocalizer L
@using WhatchaWatching.Common.Dtos

<article class="media-card @(Featured ? "featured" : "")">
    <div class="head">
        <a class="poster" href="@MediaRoutes.DetailUrl(Media.Type, Media.Id)" aria-label="@Media.Title" tabindex="-1">
            @if (Media.ImageUrl is not null)
            {
                <img src="@Media.ImageUrl" alt="" loading="lazy" />
            }
        </a>

        <div class="info">
            <h2><a href="@MediaRoutes.DetailUrl(Media.Type, Media.Id)">@Media.Title</a></h2>
            @if (MediaDisplay.CardMeta(Media, L) is { } meta)
            {
                <p class="meta">@meta</p>
            }

            @if (Media.IsAdult)
            {
                <span class="chip chip-adult">18+</span>
            }

            @if (Media.IsCustom)
            {
                <span class="chip">@L["Added by you"]</span>
            }

            @if (Featured && Media.Genres.Count > 0)
            {
                <div class="chip-list">
                    @foreach (var genre in Media.Genres)
                    {
                        <span class="chip">@genre</span>
                    }
                </div>
            }
        </div>
    </div>

    @if (Featured)
    {
        <p class="summary">@(Media.Synopsis ?? L["No summary available."])</p>
    }

    @if (ChildContent is not null)
    {
        <div class="actions">@ChildContent</div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public MediaSummaryDto Media { get; set; } = default!;

    /// <summary>Large horizontal layout used for the pick on the home page.</summary>
    [Parameter]
    public bool Featured { get; set; }

    /// <summary>Buttons shown at the bottom of the card.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
