<nav class="type-tabs" aria-label="Type of title">
    @if (AllowAll)
    {
        <a class="tab @(Selected is null ? "active" : "")" href="@UrlFor(null)"
           aria-current="@(Selected is null ? "page" : null)">All</a>
    }

    @foreach (var type in MediaRoutes.Types)
    {
        <a class="tab @(Selected == type ? "active" : "")" href="@UrlFor(type)"
           aria-current="@(Selected == type ? "page" : null)">@MediaRoutes.Label(type)</a>
    }
</nav>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    /// <summary>The type being shown; null means all of them (only when <see cref="AllowAll"/>).</summary>
    [Parameter]
    public MediaType? Selected { get; set; }

    /// <summary>Adds an "All" tab, for the list and the random pick.</summary>
    [Parameter]
    public bool AllowAll { get; set; }

    // Plain links, so that the tabs also work in the prerendered page. A change of type starts again from page one.
    private string UrlFor(MediaType? type) => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["type"] = type is { } chosen ? MediaRoutes.Slug(chosen) : null,
        ["page"] = null
    });
}
