@using WhatchaWatching.Common.Dtos

<article class="anime-card @(Featured ? "featured" : "")">
    <div class="head">
        <a class="poster" href="anime/@Anime.Id" aria-label="@Anime.Title" tabindex="-1">
            @if (Anime.ImageUrl is not null)
            {
                <img src="@Anime.ImageUrl" alt="" loading="lazy" />
            }
        </a>

        <div class="info">
            <h3><a href="anime/@Anime.Id">@Anime.Title</a></h3>
            <p class="meta">@AnimeDisplay.Duration(Anime)</p>

            @if (Anime.IsAdult)
            {
                <span class="chip chip-adult">18+</span>
            }

            @if (Anime.IsCustom)
            {
                <span class="chip">Added by you</span>
            }

            @if (Featured && Anime.Genres.Count > 0)
            {
                <div class="chip-list">
                    @foreach (var genre in Anime.Genres)
                    {
                        <span class="chip">@genre</span>
                    }
                </div>
            }
        </div>
    </div>

    @if (Featured)
    {
        <p class="summary">@(Anime.Synopsis ?? "No summary available.")</p>
    }

    @if (ChildContent is not null)
    {
        <div class="actions">@ChildContent</div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public MediaSummaryDto Anime { get; set; } = default!;

    /// <summary>Large horizontal layout used for the pick on the home page.</summary>
    [Parameter]
    public bool Featured { get; set; }

    /// <summary>Buttons shown at the bottom of the card.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
