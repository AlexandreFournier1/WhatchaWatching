@page "/search"
@inject IMediaService MediaService
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject IUserSettingsService Settings
@inject AdultFilterState AdultState
@inject NavigationManager Navigation
@inject ILogger<Search> Logger
@inject ILocalizer L

<PageTitle>@L["Search"] - WhatchaWatching</PageTitle>

<section class="page-section">
    <header class="page-header">
        <h1>@L["Search"]</h1>
        @if (!string.IsNullOrWhiteSpace(Query) && !loading && !failed)
        {
            <p class="muted fade-in">@L.F("{0} result(s) for \"{1}\"", result.TotalItems, Query)</p>
        }

        <AdultSwitch Visible="profileAllowsAdult" Value="AdultState.Enabled" ValueChanged="OnAdultChanged" />
    </header>

    @if (loading)
    {
        <div class="media-grid" aria-busy="true">
            @for (var i = 0; i < 6; i++)
            {
                <MediaCardSkeleton />
            }
        </div>
    }
    else if (failed && notConfigured)
    {
        <EmptyState Title="@L["Not available yet"]" Message="@L["This site cannot reach the movie and TV series data yet. Anime still work."]" />
    }
    else if (failed)
    {
        <EmptyState Title="@L["The search is not available"]" Message="@(Type == MediaType.Anime ? L["The anime service did not answer. Try again in a moment."] : L["The movie and series service did not answer. Try again in a moment."])">
            <button type="button" class="btn" @onclick="LoadAsync">@L["Try again"]</button>
        </EmptyState>
    }
    else if (string.IsNullOrWhiteSpace(Query))
    {
        <EmptyState Title="@SearchPrompt" Message="@L["Type a title in the search bar at the top of the page."]" />
    }
    else if (result.Items.Count == 0)
    {
        <EmptyState Title="@L["No results"]" Message="@L["Try another title."]" />
    }
    else
    {
        @if (localOnly)
        {
            <p class="notice fade-in" role="status">
                @(Type == MediaType.Anime ? L["The anime service is not answering. These are only the titles already saved on this site: the list may be incomplete."] : L["The movie and series service is not answering. These are only the titles already saved on this site: the list may be incomplete."])
            </p>
        }

        <div class="media-grid">
            @foreach (var anime in result.Items)
            {
                <MediaCard Media="anime" @key="anime.Id">
                    @if (userId is null)
                    {
                        <a class="btn btn-sm" href="@Navigation.GetLoginUrl()">@L["Log in to add"]</a>
                    }
                    else if (listed.Contains(anime.Id))
                    {
                        <button type="button" class="btn btn-ghost btn-sm" title="@L["Remove from my list"]"
                                disabled="@pending.Contains(anime.Id)" aria-busy="@(pending.Contains(anime.Id) ? "true" : "false")"
                                @onclick="() => ToggleAsync(anime.Id)">
                            @if (pending.Contains(anime.Id))
                            {
                                <span class="spinner" aria-hidden="true"></span><span>@L["Removing..."]</span>
                            }
                            else
                            {
                                <Icon Name="check" Size="16" /><span>@L["In my list"]</span>
                            }
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm"
                                disabled="@pending.Contains(anime.Id)" aria-busy="@(pending.Contains(anime.Id) ? "true" : "false")"
                                @onclick="() => ToggleAsync(anime.Id)">
                            @if (pending.Contains(anime.Id))
                            {
                                <span class="spinner" aria-hidden="true"></span><span>@L["Adding..."]</span>
                            }
                            else
                            {
                                <Icon Name="plus" Size="16" /><span>@L["Add to my list"]</span>
                            }
                        </button>
                    }
                </MediaCard>
            }
        </div>

        @if (actionFailed)
        {
            <p class="validation-message" role="alert">@L["That change could not be saved. Try again in a moment."]</p>
        }

        <Pagination Page="result.Page" TotalPages="result.TotalPages" PageChanged="GoToPage" />
    }

    @if (!loading && !string.IsNullOrWhiteSpace(Query) && Type == MediaType.Anime)
    {
        <p class="manual-link muted">@L["Still not there?"] <a href="anime/new">@L["Add it by hand"]</a>.</p>
    }
</section>

@code {
    private static readonly PagedResultDto<MediaSummaryDto> NoResult = new([], 1, 1, 0);

    // The skeleton is part of the prerendered HTML; the interactive pass then loads for real.
    private bool loading = true;
    private bool failed;
    private bool notConfigured;
    private bool actionFailed;
    private bool localOnly;
    private bool profileAllowsAdult;
    private int? userId;
    private PagedResultDto<MediaSummaryDto> result = NoResult;
    private HashSet<int> listed = [];

    // Titles being added to or removed from the list: their button shows a spinner and cannot be clicked again.
    private readonly HashSet<int> pending = [];

    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? PageNumber { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    private string? TypeSlug { get; set; }

    // Anime unless the address asks for movies or series.
    private MediaType Type => MediaRoutes.FromSlug(TypeSlug) ?? MediaType.Anime;

    // One phrase per type: the article and the gender of the word change in French.
    private string SearchPrompt => Type switch
    {
        MediaType.Movie => L["Search for a movie"],
        MediaType.TVShow => L["Search for a series"],
        _ => L["Search for an anime"]
    };

    protected override async Task OnParametersSetAsync()
    {
        loading = !string.IsNullOrWhiteSpace(Query);
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        failed = false;
        notConfigured = false;
        actionFailed = false;
        localOnly = false;

        try
        {
            userId = await CurrentUser.GetUserIdAsync();
            profileAllowsAdult = userId is { } viewer && await Settings.ShowsAdultContentAsync(viewer);
            var includeAdult = profileAllowsAdult && AdultState.Enabled;
            var search = string.IsNullOrWhiteSpace(Query)
                ? new MediaSearchResultDto(NoResult, IsLocalOnly: false)
                : await MediaService.SearchAsync(Type, Query.Trim(), PageNumber ?? 1, includeAdult);
            result = search.Results;
            localOnly = search.IsLocalOnly;

            listed = userId is { } id
                ? (await WatchList.GetListedIdsAsync(id, Type, result.Items.Select(a => a.Id).ToList())).ToHashSet()
                : [];
        }
        catch (MediaProviderUnavailableException ex)
        {
            failed = true;
            notConfigured = ex.NotConfigured;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "The search for '{Query}' failed.", Query);
            failed = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleAsync(int externalId)
    {
        // A second click while the first is still running would only repeat the request.
        if (userId is not { } id || !pending.Add(externalId))
        {
            return;
        }

        actionFailed = false;
        try
        {
            if (listed.Contains(externalId))
            {
                await WatchList.RemoveAsync(id, Type, externalId);
                listed.Remove(externalId);
            }
            else if (await WatchList.AddAsync(id, Type, externalId) == WatchListAddResult.NotFound)
            {
                actionFailed = true;
            }
            else
            {
                listed.Add(externalId);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "{Type} {ExternalId} could not be added or removed.", Type, externalId);
            actionFailed = true;
        }
        finally
        {
            pending.Remove(externalId);
        }
    }

    private async Task OnAdultChanged(bool enabled)
    {
        AdultState.Enabled = enabled;

        // The results change, so the search starts again from its first page.
        if (PageNumber is > 1)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("page", (int?)null));
        }
        else
        {
            await LoadAsync();
        }
    }

    private void GoToPage(int page) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("page", page));
}
