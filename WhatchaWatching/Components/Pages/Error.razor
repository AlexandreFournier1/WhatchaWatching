@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics
@inject ILocalizer L

<PageTitle>@L["Error"] - WhatchaWatching</PageTitle>

<section class="status-page">
    <p class="status-code">@L["Oops"]</p>
    <h1>@L["Something went wrong"]</h1>
    <p class="muted">@L["An error occurred while processing your request."]</p>

    @if (ShowRequestId)
    {
        <p class="muted">@L["Request ID:"] <code>@RequestId</code></p>
    }

    <a class="btn" href="">@L["Back to home"]</a>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
