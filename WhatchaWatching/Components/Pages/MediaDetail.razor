@page "/anime/{Id:int}"
@page "/movie/{Id:int}"
@page "/tv/{Id:int}"
@using WhatchaWatching.Common.Constants
@inject IMediaService MediaService
@inject IMediaExtrasService Extras
@inject ICustomAnimeService CustomAnimes
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject IUserSettingsService Settings
@inject NavigationManager Navigation
@inject ILogger<MediaDetail> Logger
@inject ILocalizer L

<PageTitle>@(media?.Title ?? L[MediaRoutes.Badge(Type)]) - WhatchaWatching</PageTitle>

<section class="page-section">
    @if (loading)
    {
        <div class="detail" aria-busy="true" aria-hidden="true">
            <div class="poster shimmer"></div>

            <div class="content">
                <div class="line title shimmer"></div>
                <div class="line medium shimmer"></div>
                <div class="line short shimmer"></div>
                <div class="line shimmer"></div>
                <div class="line shimmer"></div>
                <div class="line medium shimmer"></div>
            </div>
        </div>
    }
    else if (failed && notConfigured)
    {
        <EmptyState Title="@L["Not available yet"]" Message="@L["This site cannot reach the movie and TV series data yet. Anime still work."]" />
    }
    else if (failed)
    {
        <EmptyState Title="@NotLoadedTitle" Message="@L["The service did not answer. Try again in a moment."]">
            <button type="button" class="btn" @onclick="LoadAsync">@L["Try again"]</button>
        </EmptyState>
    }
    else if (media is null)
    {
        <EmptyState Title="@NotFoundTitle" Message="@L["This title does not exist or is not available."]">
            <a class="btn" href="@MediaRoutes.SearchUrl(Type)">@L["Back to search"]</a>
        </EmptyState>
    }
    else
    {
        <article class="detail fade-in">
            <div class="poster">
                @if (media.ImageUrl is not null)
                {
                    <img src="@media.ImageUrl" alt="@media.Title" />
                }
            </div>

            <div class="content">
                <h1>@media.Title</h1>

                <p class="meta">
                    @if (media.Year is { } year)
                    {
                        <span>@year</span>
                    }
                    @if (MediaDisplay.Episodes(media, L) is { } episodes)
                    {
                        <span>@episodes</span>
                    }
                    <span>@MediaDisplay.Duration(media, L)</span>
                    @if (MediaDisplay.Status(media, L) is { } status)
                    {
                        <span>@status</span>
                    }
                    @if (media.Score is { } score)
                    {
                        <span class="score" title="@MediaDisplay.ScoreSource(media, L)">&#9733; @score.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    }
                </p>

                <div class="chip-list">
                    @if (media.IsAdult)
                    {
                        <span class="chip chip-adult">18+</span>
                    }
                    @foreach (var genre in media.Genres)
                    {
                        <span class="chip">@genre</span>
                    }
                </div>

                <p class="synopsis">@(media.Synopsis ?? L["No summary available."])</p>

                @if (media.IsCustom)
                {
                    <p class="notice">@L["You added this anime by hand. Only you can see it."]</p>
                }
                else
                {
                    <section class="watch" aria-labelledby="watch-title">
                        <h2 id="watch-title">@L["Where to watch"]</h2>

                        @if (VisibleLinks.Count > 0)
                        {
                            <ul class="watch-links">
                                @foreach (var link in VisibleLinks)
                                {
                                    <li>
                                        <a class="btn btn-ghost btn-sm" href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Site</a>
                                    </li>
                                }
                            </ul>
                            <p class="muted small">
                                @if (media.Type == MediaType.Anime)
                                {
                                    <span>@L["Availability depends on your country."]</span>
                                }
                                else
                                {
                                    <span>@L.F("Platforms for {0}.", L[CountryCatalog.NameOf(region)]) <a href="account">@L["Change the country"]</a>.</span>
                                }
                                @if (media.Type != MediaType.Anime)
                                {
                                    <span>@L["Streaming data by"] <a href="https://www.justwatch.com/" target="_blank" rel="noopener noreferrer">JustWatch</a>, @L["through TMDB."]</span>
                                }
                            </p>
                        }
                        else
                        {
                            <p class="muted">@(media.Type == MediaType.Anime ? L["No streaming platform is known for this anime."] : L.F("No streaming platform is known for this title in {0}.", L[CountryCatalog.NameOf(region)]))</p>
                        }
                    </section>
                }

                <div class="actions">
                    @if (userId is null)
                    {
                        <a class="btn" href="@Navigation.GetLoginUrl()">@L["Log in to add to my list"]</a>
                    }
                    else if (media.IsCustom)
                    {
                        // Removing an anime added by hand deletes it, so it asks first.
                        @if (confirmingDelete)
                        {
                            <button type="button" class="btn btn-danger" disabled="@busy" aria-busy="@(busy ? "true" : "false")" @onclick="ToggleAsync">
                                @if (busy)
                                {
                                    <span class="spinner" aria-hidden="true"></span><span>@L["Deleting..."]</span>
                                }
                                else
                                {
                                    <Icon Name="trash" Size="16" /><span>@L["Yes, delete it for good"]</span>
                                }
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="() => confirmingDelete = false">@L["Keep it"]</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" @onclick="() => confirmingDelete = true">
                                <Icon Name="trash" Size="16" /> @L["Delete this anime"]
                            </button>
                        }
                    }
                    else if (listed)
                    {
                        <button type="button" class="btn btn-danger" disabled="@busy" aria-busy="@(busy ? "true" : "false")" @onclick="ToggleAsync">
                            @if (busy)
                            {
                                <span class="spinner" aria-hidden="true"></span><span>@L["Removing..."]</span>
                            }
                            else
                            {
                                <Icon Name="trash" Size="16" /><span>@L["Remove from my list"]</span>
                            }
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn" disabled="@busy" aria-busy="@(busy ? "true" : "false")" @onclick="ToggleAsync">
                            @if (busy)
                            {
                                <span class="spinner" aria-hidden="true"></span><span>@L["Adding..."]</span>
                            }
                            else
                            {
                                <Icon Name="plus" Size="16" /><span>@L["Add to my list"]</span>
                            }
                        </button>
                    }
                    <a class="btn btn-ghost" href="my-list">@L["My List"]</a>
                </div>

                @if (actionFailed)
                {
                    <p class="validation-message" role="alert">@L["That change could not be saved. Try again in a moment."]</p>
                }
            </div>
        </article>

        @if (extras is { IsEmpty: false })
        {
            <div class="extras fade-in">
                @if (extras.Trailer is { } trailer)
                {
                    <p><a class="btn" href="@trailer.Url" target="_blank" rel="noopener noreferrer">@L["Watch the trailer"]</a></p>
                }

                @if (extras.Seasons.Count > 0)
                {
                    <section aria-labelledby="seasons-title">
                        <h2 id="seasons-title">@L["Seasons"]</h2>
                        <ul class="seasons">
                            @foreach (var season in extras.Seasons)
                            {
                                <li>
                                    <span class="season-name">@season.Name</span>
                                    <span class="muted">
                                        @(season.EpisodeCount is { } count ? L.F(count == 1 ? "{0} episode" : "{0} episodes", count) : L["Episodes unknown"])@(season.Year is { } seasonYear ? $" 00b7 {seasonYear}" : string.Empty)
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                }

                @if (extras.Cast.Count > 0)
                {
                    <section aria-labelledby="cast-title">
                        <h2 id="cast-title">@L["Cast"]</h2>
                        <ul class="cast">
                            @foreach (var member in extras.Cast)
                            {
                                <li>
                                    <span class="photo">
                                        @if (member.PhotoUrl is not null)
                                        {
                                            <img src="@member.PhotoUrl" alt="" loading="lazy" />
                                        }
                                    </span>
                                    <span class="actor">@member.Name</span>
                                    @if (member.Character is not null)
                                    {
                                        <span class="muted small">@member.Character</span>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }

                @if (extras.Similar.Count > 0)
                {
                    <section aria-labelledby="similar-title">
                        <h2 id="similar-title">@L["Similar titles"]</h2>
                        <ul class="similar">
                            @foreach (var other in extras.Similar)
                            {
                                <li>
                                    <a href="@MediaRoutes.DetailUrl(other.Type, other.ExternalId)">
                                        <img src="@other.ImageUrl" alt="" loading="lazy" />
                                        <span class="similar-title">@other.Title</span>
                                        @if (other.Year is { } otherYear)
                                        {
                                            <span class="muted small">@otherYear</span>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
    }
</section>

@code {
    private MediaSummaryDto? media;
    private int? userId;
    private bool listed;
    private bool failed;
    private bool notConfigured;
    private string region = CountryCatalog.DEFAULT_CODE;

    // One phrase per type: the article and the gender of the word change in French.
    private string NotLoadedTitle => Type switch
    {
        MediaType.Movie => L["This movie could not be loaded"],
        MediaType.TVShow => L["This series could not be loaded"],
        _ => L["This anime could not be loaded"]
    };

    private string NotFoundTitle => Type switch
    {
        MediaType.Movie => L["Movie not found"],
        MediaType.TVShow => L["TV series not found"],
        _ => L["Anime not found"]
    };
    private MediaExtrasDto? extras;

    // The offers of the country of the viewer; an offer without a country (an anime) counts everywhere.
    private IReadOnlyList<StreamingLinkDto> VisibleLinks =>
        media?.StreamingLinks.Where(l => l.Region is null || l.Region == region).ToList() ?? [];
    private bool actionFailed;
    private bool confirmingDelete;
    private bool busy;
    // The skeleton is part of the prerendered HTML; the interactive pass then loads for real.
    private bool loading = true;

    [Parameter]
    public int Id { get; set; }

    // /anime/5, /movie/5 and /tv/5 are the same page: the first word of the address says which one.
    private MediaType Type { get; set; } = MediaType.Anime;

    protected override async Task OnParametersSetAsync()
    {
        Type = MediaRoutes.FromSlug(Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', '?', '#')[0]) ?? MediaType.Anime;
        loading = true;
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        failed = false;
        extras = null;
        var includeAdult = false;
        notConfigured = false;
        actionFailed = false;

        try
        {
            userId = await CurrentUser.GetUserIdAsync();
            includeAdult = userId is { } viewer && await Settings.ShowsAdultContentAsync(viewer);
            region = userId is { } who ? await Settings.GetCountryAsync(who) : CountryCatalog.DEFAULT_CODE;

            if (Id <= 0)
            {
                // An anime added by hand: private, so only its owner can open it.
                media = Type == MediaType.Anime && userId is { } owner ? await CustomAnimes.GetAsync(owner, Id) : null;
                listed = media is not null;
            }
            else
            {
                media = await MediaService.GetAsync(Type, Id, includeAdult);
                listed = media is not null && userId is { } id
                    && (await WatchList.GetListedIdsAsync(id, Type, [Id])).Contains(Id);
            }
        }
        catch (MediaProviderUnavailableException ex)
        {
            failed = true;
            notConfigured = ex.NotConfigured;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "{Type} {Id} could not be loaded.", Type, Id);
            failed = true;
        }
        finally
        {
            loading = false;
        }

        // The page is complete without them: they come in when they arrive, and never delay it.
        if (!failed && media is { IsCustom: false } && Id > 0 && Type != MediaType.Anime)
        {
            _ = LoadExtrasAsync(Type, Id, includeAdult);
        }
    }

    private async Task LoadExtrasAsync(MediaType type, int id, bool includeAdult)
    {
        var loaded = await Extras.GetAsync(type, id, includeAdult);

        // The page may have moved on to another title while this was loading.
        if (type != Type || id != Id)
        {
            return;
        }

        extras = loaded;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The visitor left the page.
        }
    }

    private async Task ToggleAsync()
    {
        // A second click while the first is still running would only repeat the request.
        if (userId is not { } id || busy)
        {
            return;
        }

        busy = true;
        actionFailed = false;
        try
        {
            if (media?.IsCustom == true)
            {
                await WatchList.RemoveAsync(id, Type, Id);
                Navigation.NavigateTo("my-list");
                return;
            }

            if (listed)
            {
                await WatchList.RemoveAsync(id, Type, Id);
                listed = false;
            }
            else if (await WatchList.AddAsync(id, Type, Id) == WatchListAddResult.NotFound)
            {
                actionFailed = true;
            }
            else
            {
                listed = true;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "{Type} {Id} could not be added or removed.", Type, Id);
            actionFailed = true;
        }
        finally
        {
            busy = false;
        }
    }
}
