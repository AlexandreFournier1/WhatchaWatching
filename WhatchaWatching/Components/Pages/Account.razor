@page "/account"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>My account - WhatchaWatching</PageTitle>

<section class="auth">
    <h1>My account</h1>

    <AuthorizeView>
        <div class="card form">
            <div class="field">
                <label for="username">Username</label>
                <input id="username" class="input" type="text" readonly value="@context.User.Identity?.Name" />
            </div>

            <div class="field">
                <label for="email">Email</label>
                <input id="email" class="input" type="email" readonly value="@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" />
            </div>

            <form method="post" action="logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-ghost">Log out</button>
            </form>
        </div>
    </AuthorizeView>
</section>
