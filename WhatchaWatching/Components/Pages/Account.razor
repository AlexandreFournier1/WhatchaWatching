@page "/account"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject IUserSettingsService Settings
@inject ICurrentUser CurrentUser

<PageTitle>My account - WhatchaWatching</PageTitle>

<section class="auth">
    <h1>My account</h1>

    <AuthorizeView>
        <div class="card form">
            <div class="field">
                <label for="username">Username</label>
                <input id="username" class="input" type="text" readonly value="@context.User.Identity?.Name" />
            </div>

            <div class="field">
                <label for="email">Email</label>
                <input id="email" class="input" type="email" readonly value="@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" />
            </div>

            <form method="post" action="logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-ghost">Log out</button>
            </form>
        </div>
    </AuthorizeView>

    <EditForm Model="Input" method="post" OnValidSubmit="SaveAsync" FormName="content-settings" class="card form">
        <h2>Content</h2>

        <label class="remember">
            <InputCheckbox @bind-Value="Input.ShowAdultContent" /> Show adult content (18+)
        </label>
        <p class="muted small">
            Adult anime (hentai and the like) are hidden by default: they do not show up in searches, in your list or
            in the random pick. By turning this on you confirm that you are at least 18 years old and that you are
            allowed to see such content where you live.
        </p>

        @if (saved)
        {
            <p class="notice" role="status">Saved.</p>
        }

        @if (failed)
        {
            <p class="validation-message" role="alert">The setting could not be saved. Try again in a moment.</p>
        }

        <button type="submit" class="btn">Save</button>
    </EditForm>
</section>

@code {
    private bool saved;
    private bool failed;

    [SupplyParameterFromForm]
    private ContentSettings Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // After a post the form has already filled Input: the stored value must not replace what was just sent.
        var posted = Input is not null;

        // The model exists before the first await: Blazor renders the page as soon as the component waits, and the form
        // cannot be rendered without its model.
        Input ??= new ContentSettings();

        if (!posted && await CurrentUser.GetUserIdAsync() is { } userId)
        {
            Input.ShowAdultContent = await Settings.ShowsAdultContentAsync(userId);
        }
    }

    private async Task SaveAsync()
    {
        saved = false;
        failed = false;

        try
        {
            var userId = await CurrentUser.GetUserIdAsync() ?? throw new InvalidOperationException("Not signed in.");
            await Settings.SetShowsAdultContentAsync(userId, Input.ShowAdultContent);
            saved = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            failed = true;
        }
    }

    private sealed class ContentSettings
    {
        public bool ShowAdultContent { get; set; }
    }
}
