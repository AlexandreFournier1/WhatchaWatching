@page "/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using WhatchaWatching.Infrastructure.Data.Entities
@using WhatchaWatching.Services.Email
@inject UserManager<UserEntity> UserManager
@inject ILocalizer L
@inject IAccountEmailService AccountEmail

<PageTitle>@L["Forgot your password?"] - WhatchaWatching</PageTitle>

<section class="auth">
    <h1>@L["Forgot your password?"]</h1>

    @if (sent)
    {
        @* The same answer whether or not an account uses the address: the page must not tell who has an account. *@
        <p class="notice" role="status">
            @L["If an account uses this address, an email with a link to choose a new password is on its way."]
            @L["The link works for two hours."]
        </p>
        <p class="switch"><a href="login">@L["Back to log in"]</a></p>
    }
    else
    {
        <p class="muted">@L["Enter the email address of your account and we will send you a link to choose a new password."]</p>

        <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot-password">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="email">@L["Email"]</label>
                <InputText id="email" type="email" class="input" autocomplete="email" @bind-Value="Input.Email" />
                <LocalizedValidationMessage For="() => Input.Email" />
            </div>

            <button type="submit" class="btn">@L["Send the link"]</button>
        </EditForm>

        <p class="switch"><a href="login">@L["Back to log in"]</a></p>
    }
</section>

@code {
    private bool sent;

    [SupplyParameterFromForm]
    private ForgotInput Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
        if (user is not null)
        {
            // Whether it went out or not, the visitor reads the same thing: a failure is for the logs.
            await AccountEmail.SendPasswordResetAsync(user);
        }

        sent = true;
    }

    private sealed class ForgotInput
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "This does not look like an email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
