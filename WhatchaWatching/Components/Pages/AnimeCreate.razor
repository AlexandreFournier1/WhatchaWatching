@page "/anime/new"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using WhatchaWatching.Common.Constants
@inject ICustomAnimeService CustomAnimes
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation
@inject ILogger<AnimeCreate> Logger
@inject ILocalizer L

<PageTitle>@L["Add an anime"] - WhatchaWatching</PageTitle>

<section class="page-section">
    <div class="form-card">
        <header class="page-header">
            <h1>@L["Add an anime by hand"]</h1>
            <p class="muted">
                @L["Use this only when searching does not find it. The anime goes into your list and nobody else can see it."]
            </p>
        </header>

        <EditForm Model="model" OnValidSubmit="SaveAsync" class="custom-form">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="title">@L["Title"]</label>
                <InputText id="title" class="input" @bind-Value="model.Title" maxlength="@ConfigurationConstants.LARGE_SIZE" />
                <LocalizedValidationMessage For="() => model.Title" />
            </div>

            <div class="field">
                <label for="original">@L["Original title"] <span class="muted">@L["(optional)"]</span></label>
                <InputText id="original" class="input" @bind-Value="model.OriginalTitle" maxlength="@ConfigurationConstants.LARGE_SIZE" />
                <LocalizedValidationMessage For="() => model.OriginalTitle" />
            </div>

            <div class="field">
                <label for="synopsis">@L["Summary"] <span class="muted">@L["(optional)"]</span></label>
                <InputTextArea id="synopsis" class="input" rows="5" @bind-Value="model.Synopsis" maxlength="@ConfigurationConstants.XXXL_SIZE" />
                <LocalizedValidationMessage For="() => model.Synopsis" />
            </div>

            <div class="field">
                <label for="image">@L["Poster address"] <span class="muted">@L["(optional)"]</span></label>
                <InputText id="image" type="url" class="input" placeholder="https://..." @bind-Value="model.ImageUrl" maxlength="@ConfigurationConstants.LARGE_SIZE" />
                <small class="muted">@L["The address of an image on the web, starting with https://."]</small>
                <LocalizedValidationMessage For="() => model.ImageUrl" />
            </div>

            <div class="row">
                <div class="field">
                    <label for="episodes">@L["Episodes"] <span class="muted">@L["(optional)"]</span></label>
                    <InputNumber id="episodes" class="input" @bind-Value="model.EpisodeCount" />
                    <LocalizedValidationMessage For="() => model.EpisodeCount" />
                </div>

                <div class="field">
                    <label for="duration">@L["Minutes per episode"] <span class="muted">@L["(optional)"]</span></label>
                    <InputNumber id="duration" class="input" @bind-Value="model.EpisodeDurationMinutes" />
                    <LocalizedValidationMessage For="() => model.EpisodeDurationMinutes" />
                </div>

                <div class="field">
                    <label for="year">@L["Year"] <span class="muted">@L["(optional)"]</span></label>
                    <InputNumber id="year" class="input" @bind-Value="model.Year" />
                    <LocalizedValidationMessage For="() => model.Year" />
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label for="status">@L["Status"]</label>
                    <InputSelect id="status" class="input" @bind-Value="model.Status">
                        <option value="@MediaStatus.Finished">@L["Finished airing"]</option>
                        <option value="@MediaStatus.Airing">@L["Currently airing"]</option>
                        <option value="@MediaStatus.Upcoming">@L["Not yet aired"]</option>
                    </InputSelect>
                </div>

                <div class="field">
                    <span class="label">@L["Genres"] <span class="muted">@L["(optional)"]</span></span>
                    <FilterDropdown Label="@L["Choose genres"]" Multiple="true" Options="FilterOptions.Plain(genreNames)"
                                    Selected="model.Genres" SelectedChanged="OnGenresChanged" />
                </div>
            </div>

            @if (error is not null)
            {
                <p class="validation-message" role="alert">@error</p>
            }

            <div class="buttons">
                <button type="submit" class="btn" disabled="@saving">@(saving ? L["Saving..."] : L["Add to my list"])</button>
                <a class="btn btn-ghost" href="my-list">@L["Cancel"]</a>
            </div>
        </EditForm>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<string> genreNames = GenreCatalog.All.Select(g => g.Name).Order().ToList();

    private readonly CustomAnimeDto model = new();
    private bool saving;
    private string? error;

    private void OnGenresChanged(IReadOnlyCollection<string> selected) => model.Genres = selected.ToList();

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        error = null;

        try
        {
            var userId = await CurrentUser.GetUserIdAsync() ?? throw new InvalidOperationException("Not signed in.");
            var created = await CustomAnimes.CreateAsync(userId, model);

            Navigation.NavigateTo($"anime/{created.Id}");
        }
        catch (ValidationException ex)
        {
            // The service's messages are written for users ("You can add up to 200 anime by hand...").
            error = ex.Message;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "An anime added by hand could not be saved.");
            error = L["The anime could not be saved. Try again in a moment."];
        }
        finally
        {
            saving = false;
        }
    }
}
