@page "/anime/{Id:int}"
@inject IAnimeService AnimeService
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation
@inject ILogger<AnimeDetail> Logger

<PageTitle>@(anime?.Title ?? "Anime") - WhatchaWatching</PageTitle>

<section class="page-section">
    @if (loading)
    {
        <div class="detail" aria-busy="true" aria-hidden="true">
            <div class="poster shimmer"></div>

            <div class="content">
                <div class="line title shimmer"></div>
                <div class="line medium shimmer"></div>
                <div class="line short shimmer"></div>
                <div class="line shimmer"></div>
                <div class="line shimmer"></div>
                <div class="line medium shimmer"></div>
            </div>
        </div>
    }
    else if (failed)
    {
        <EmptyState Title="This anime could not be loaded" Message="The anime service did not answer. Try again in a moment.">
            <button type="button" class="btn" @onclick="LoadAsync">Try again</button>
        </EmptyState>
    }
    else if (anime is null)
    {
        <EmptyState Title="Anime not found" Message="This anime does not exist or is not available.">
            <a class="btn" href="search">Back to search</a>
        </EmptyState>
    }
    else
    {
        <article class="detail fade-in">
            <div class="poster">
                @if (anime.ImageUrl is not null)
                {
                    <img src="@anime.ImageUrl" alt="@anime.Title" />
                }
            </div>

            <div class="content">
                <h1>@anime.Title</h1>

                <p class="meta">
                    @if (anime.Year is { } year)
                    {
                        <span>@year</span>
                    }
                    <span>@AnimeDisplay.Episodes(anime)</span>
                    <span>@AnimeDisplay.Duration(anime)</span>
                    @if (anime.Status is not null)
                    {
                        <span>@anime.Status</span>
                    }
                    @if (anime.Score is { } score)
                    {
                        <span class="score" title="MyAnimeList score">&#9733; @score.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    }
                </p>

                <div class="chip-list">
                    @foreach (var genre in anime.Genres)
                    {
                        <span class="chip">@genre</span>
                    }
                </div>

                <p class="synopsis">@(anime.Synopsis ?? "No summary available.")</p>

                <section class="watch" aria-labelledby="watch-title">
                    <h2 id="watch-title">Where to watch</h2>

                    @if (anime.StreamingLinks.Count > 0)
                    {
                        <ul class="watch-links">
                            @foreach (var link in anime.StreamingLinks)
                            {
                                <li>
                                    <a class="btn btn-ghost btn-sm" href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Site</a>
                                </li>
                            }
                        </ul>
                        <p class="muted small">Availability depends on your country.</p>
                    }
                    else
                    {
                        <p class="muted">No streaming platform is known for this anime.</p>
                    }
                </section>

                <div class="actions">
                    @if (userId is null)
                    {
                        <a class="btn" href="@Navigation.GetLoginUrl()">Log in to add to my list</a>
                    }
                    else if (listed)
                    {
                        <button type="button" class="btn btn-danger" @onclick="ToggleAsync">
                            <Icon Name="trash" Size="16" /> Remove from my list
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn" @onclick="ToggleAsync">
                            <Icon Name="plus" Size="16" /> Add to my list
                        </button>
                    }
                    <a class="btn btn-ghost" href="my-list">My List</a>
                </div>

                @if (actionFailed)
                {
                    <p class="validation-message" role="alert">That change could not be saved. Try again in a moment.</p>
                }
            </div>
        </article>
    }
</section>

@code {
    private AnimeSummaryDto? anime;
    private int? userId;
    private bool listed;
    private bool failed;
    private bool actionFailed;
    // The skeleton is part of the prerendered HTML; the interactive pass then loads for real.
    private bool loading = true;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        failed = false;
        actionFailed = false;

        try
        {
            anime = await AnimeService.GetAsync(Id);
            userId = await CurrentUser.GetUserIdAsync();
            listed = anime is not null && userId is { } id
                && (await WatchList.GetListedIdsAsync(id, [Id])).Contains(Id);
        }
        catch (AnimeProviderUnavailableException)
        {
            failed = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Anime {Id} could not be loaded.", Id);
            failed = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleAsync()
    {
        if (userId is not { } id)
        {
            return;
        }

        actionFailed = false;
        try
        {
            if (listed)
            {
                await WatchList.RemoveAsync(id, Id);
            }
            else
            {
                await WatchList.AddAsync(id, Id);
            }

            listed = !listed;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Anime {Id} could not be added or removed.", Id);
            actionFailed = true;
        }
    }
}
