@page "/anime/{Id:int}"
@inject IMediaService MediaService
@inject ICustomAnimeService CustomAnimes
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject IUserSettingsService Settings
@inject NavigationManager Navigation
@inject ILogger<AnimeDetail> Logger

<PageTitle>@(anime?.Title ?? "Anime") - WhatchaWatching</PageTitle>

<section class="page-section">
    @if (loading)
    {
        <div class="detail" aria-busy="true" aria-hidden="true">
            <div class="poster shimmer"></div>

            <div class="content">
                <div class="line title shimmer"></div>
                <div class="line medium shimmer"></div>
                <div class="line short shimmer"></div>
                <div class="line shimmer"></div>
                <div class="line shimmer"></div>
                <div class="line medium shimmer"></div>
            </div>
        </div>
    }
    else if (failed)
    {
        <EmptyState Title="This anime could not be loaded" Message="The anime service did not answer. Try again in a moment.">
            <button type="button" class="btn" @onclick="LoadAsync">Try again</button>
        </EmptyState>
    }
    else if (anime is null)
    {
        <EmptyState Title="Anime not found" Message="This anime does not exist or is not available.">
            <a class="btn" href="search">Back to search</a>
        </EmptyState>
    }
    else
    {
        <article class="detail fade-in">
            <div class="poster">
                @if (anime.ImageUrl is not null)
                {
                    <img src="@anime.ImageUrl" alt="@anime.Title" />
                }
            </div>

            <div class="content">
                <h1>@anime.Title</h1>

                <p class="meta">
                    @if (anime.Year is { } year)
                    {
                        <span>@year</span>
                    }
                    <span>@AnimeDisplay.Episodes(anime)</span>
                    <span>@AnimeDisplay.Duration(anime)</span>
                    @if (anime.Status is not null)
                    {
                        <span>@anime.Status</span>
                    }
                    @if (anime.Score is { } score)
                    {
                        <span class="score" title="MyAnimeList score">&#9733; @score.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    }
                </p>

                <div class="chip-list">
                    @if (anime.IsAdult)
                    {
                        <span class="chip chip-adult">18+</span>
                    }
                    @foreach (var genre in anime.Genres)
                    {
                        <span class="chip">@genre</span>
                    }
                </div>

                <p class="synopsis">@(anime.Synopsis ?? "No summary available.")</p>

                @if (anime.IsCustom)
                {
                    <p class="notice">You added this anime by hand. Only you can see it.</p>
                }
                else
                {
                    <section class="watch" aria-labelledby="watch-title">
                        <h2 id="watch-title">Where to watch</h2>

                        @if (anime.StreamingLinks.Count > 0)
                        {
                            <ul class="watch-links">
                                @foreach (var link in anime.StreamingLinks)
                                {
                                    <li>
                                        <a class="btn btn-ghost btn-sm" href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Site</a>
                                    </li>
                                }
                            </ul>
                            <p class="muted small">Availability depends on your country.</p>
                        }
                        else
                        {
                            <p class="muted">No streaming platform is known for this anime.</p>
                        }
                    </section>
                }

                <div class="actions">
                    @if (userId is null)
                    {
                        <a class="btn" href="@Navigation.GetLoginUrl()">Log in to add to my list</a>
                    }
                    else if (anime.IsCustom)
                    {
                        // Removing an anime added by hand deletes it, so it asks first.
                        @if (confirmingDelete)
                        {
                            <button type="button" class="btn btn-danger" disabled="@busy" aria-busy="@(busy ? "true" : "false")" @onclick="ToggleAsync">
                                @if (busy)
                                {
                                    <span class="spinner" aria-hidden="true"></span><span>Deleting...</span>
                                }
                                else
                                {
                                    <Icon Name="trash" Size="16" /><span>Yes, delete it for good</span>
                                }
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="() => confirmingDelete = false">Keep it</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" @onclick="() => confirmingDelete = true">
                                <Icon Name="trash" Size="16" /> Delete this anime
                            </button>
                        }
                    }
                    else if (listed)
                    {
                        <button type="button" class="btn btn-danger" disabled="@busy" aria-busy="@(busy ? "true" : "false")" @onclick="ToggleAsync">
                            @if (busy)
                            {
                                <span class="spinner" aria-hidden="true"></span><span>Removing...</span>
                            }
                            else
                            {
                                <Icon Name="trash" Size="16" /><span>Remove from my list</span>
                            }
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn" disabled="@busy" aria-busy="@(busy ? "true" : "false")" @onclick="ToggleAsync">
                            @if (busy)
                            {
                                <span class="spinner" aria-hidden="true"></span><span>Adding...</span>
                            }
                            else
                            {
                                <Icon Name="plus" Size="16" /><span>Add to my list</span>
                            }
                        </button>
                    }
                    <a class="btn btn-ghost" href="my-list">My List</a>
                </div>

                @if (actionFailed)
                {
                    <p class="validation-message" role="alert">That change could not be saved. Try again in a moment.</p>
                }
            </div>
        </article>
    }
</section>

@code {
    private MediaSummaryDto? anime;
    private int? userId;
    private bool listed;
    private bool failed;
    private bool actionFailed;
    private bool confirmingDelete;
    private bool busy;
    // The skeleton is part of the prerendered HTML; the interactive pass then loads for real.
    private bool loading = true;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        failed = false;
        actionFailed = false;

        try
        {
            userId = await CurrentUser.GetUserIdAsync();
            var includeAdult = userId is { } viewer && await Settings.ShowsAdultContentAsync(viewer);

            if (Id <= 0)
            {
                // An anime added by hand: private, so only its owner can open it.
                anime = userId is { } owner ? await CustomAnimes.GetAsync(owner, Id) : null;
                listed = anime is not null;
            }
            else
            {
                anime = await MediaService.GetAsync(MediaType.Anime, Id, includeAdult);
                listed = anime is not null && userId is { } id
                    && (await WatchList.GetListedIdsAsync(id, MediaType.Anime, [Id])).Contains(Id);
            }
        }
        catch (MediaProviderUnavailableException)
        {
            failed = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Anime {Id} could not be loaded.", Id);
            failed = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleAsync()
    {
        // A second click while the first is still running would only repeat the request.
        if (userId is not { } id || busy)
        {
            return;
        }

        busy = true;
        actionFailed = false;
        try
        {
            if (anime?.IsCustom == true)
            {
                await WatchList.RemoveAsync(id, MediaType.Anime, Id);
                Navigation.NavigateTo("my-list");
                return;
            }

            if (listed)
            {
                await WatchList.RemoveAsync(id, MediaType.Anime, Id);
                listed = false;
            }
            else if (await WatchList.AddAsync(id, MediaType.Anime, Id) == WatchListAddResult.NotFound)
            {
                actionFailed = true;
            }
            else
            {
                listed = true;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Anime {Id} could not be added or removed.", Id);
            actionFailed = true;
        }
        finally
        {
            busy = false;
        }
    }
}
