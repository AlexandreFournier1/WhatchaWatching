@page "/my-list"
@inject PreviewWatchList WatchList

<PageTitle>My List - WhatchaWatching</PageTitle>

<section class="page-section">
    <header class="page-header">
        <h1>My List</h1>
        @if (!loading)
        {
            <p class="muted fade-in">@WatchList.Items.Count to watch</p>
        }
    </header>

    @if (loading)
    {
        <div class="anime-grid" aria-busy="true">
            @for (var i = 0; i < 4; i++)
            {
                <AnimeCardSkeleton />
            }
        </div>
    }
    else if (WatchList.Items.Count == 0)
    {
        <EmptyState Title="Your list is empty" Message="Search for an anime and add it to your list.">
            <a class="btn" href="search">Find something to add</a>
        </EmptyState>
    }
    else
    {
        <div class="filters">
            <FilterDropdown Label="Genre" Multiple="true" Options="WatchList.Genres" @bind-Selected="genres" />
            <FilterDropdown Label="Duration" Options="PreviewWatchList.DurationOptions" @bind-Selected="duration" />
            <FilterDropdown Label="Sort by" Options="PreviewWatchList.SortOptions" @bind-Selected="sort" />
        </div>

        @if (Visible.Count == 0)
        {
            <EmptyState Title="No match" Message="Nothing in your list matches these filters." />
        }
        else
        {
            <div class="anime-grid">
                @foreach (var anime in Visible)
                {
                    <AnimeCard Anime="anime" @key="anime.Id">
                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => WatchList.Remove(anime.Id)">
                            <Icon Name="trash" Size="16" /> Remove
                        </button>
                    </AnimeCard>
                }
            </div>
        }
    }
</section>

@code {
    // Stays true during prerendering, so the skeleton is part of the first HTML.
    private bool loading = true;
    private IReadOnlyCollection<string> genres = [];
    private IReadOnlyCollection<string> duration = [];
    private IReadOnlyCollection<string> sort = [];

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await PreviewWatchList.SimulateLatency();
            loading = false;
        }
    }

    private IReadOnlyList<AnimeSummaryDto> Visible
    {
        get
        {
            var items = WatchList.Items
                .Where(a => PreviewWatchList.MatchesGenres(a, genres))
                .Where(a => PreviewWatchList.MatchesDuration(a, duration.FirstOrDefault()));

            return sort.FirstOrDefault() switch
            {
                "Title (A-Z)" => items.OrderBy(a => a.Title).ToList(),
                "Shortest first" => items.OrderBy(a => a.EpisodeDurationMinutes ?? int.MaxValue).ToList(),
                _ => items.ToList()
            };
        }
    }
}
