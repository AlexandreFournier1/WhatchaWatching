@page "/my-list"
@attribute [Authorize]
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject ILogger<MyList> Logger

<PageTitle>My List - WhatchaWatching</PageTitle>

<section class="page-section">
    <header class="page-header">
        <h1>My List</h1>
        @if (!loading && !failed)
        {
            <p class="muted fade-in">@items.Count @(IsFiltered ? "matching" : "to watch")</p>
            @if (Type == MediaType.Anime)
            {
                <p class="fade-in"><a href="anime/new">Add an anime by hand</a></p>
            }
        }
    </header>

    @if (loading)
    {
        <div class="media-grid" aria-busy="true">
            @for (var i = 0; i < 4; i++)
            {
                <MediaCardSkeleton />
            }
        </div>
    }
    else if (failed)
    {
        <EmptyState Title="Your list could not be loaded" Message="Try again in a moment.">
            <button type="button" class="btn" @onclick="ReloadAsync">Try again</button>
        </EmptyState>
    }
    else if (items.Count == 0 && !IsFiltered)
    {
        <EmptyState Title="@($"No {MediaRoutes.Label(Type).ToLowerInvariant()} in your list")" Message="Search for something and add it to your list.">
            <a class="btn" href="@MediaRoutes.SearchUrl(Type)">Find something to add</a>
        </EmptyState>
    }
    else
    {
        <div class="filters">
            <FilterDropdown Label="Genre" Multiple="true" Options="genreOptions" Selected="genres" SelectedChanged="OnGenresChanged" />
            <FilterDropdown Label="Duration" Options="FilterOptions.DurationLabels" Selected="duration" SelectedChanged="OnDurationChanged" />
            <FilterDropdown Label="Sort by" Options="FilterOptions.SortLabels" Selected="sort" SelectedChanged="OnSortChanged" />
        </div>

        @if (items.Count == 0)
        {
            <EmptyState Title="No match" Message="Nothing in your list matches these filters." />
        }
        else
        {
            <div class="media-grid @(busy ? "is-busy" : "")" aria-busy="@(busy ? "true" : "false")">
                @foreach (var anime in items)
                {
                    <MediaCard Media="anime" @key="(anime.Type, anime.Id)">
                        <button type="button" class="btn btn-danger btn-sm" title="@(anime.IsCustom ? "Remove and delete this anime" : "Remove from my list")"
                                disabled="@removing.Contains(Key(anime))" aria-busy="@(removing.Contains(Key(anime)) ? "true" : "false")"
                                @onclick="() => RemoveAsync(anime)">
                            @if (removing.Contains(Key(anime)))
                            {
                                <span class="spinner" aria-hidden="true"></span><span>Removing...</span>
                            }
                            else
                            {
                                <Icon Name="trash" Size="16" /><span>Remove</span>
                            }
                        </button>
                    </MediaCard>
                }
            </div>
        }
    }
</section>

@code {
    // Stays true while the page is prerendered: the skeleton is part of the first HTML.
    private bool loading = true;
    private bool busy;

    // Titles being removed: their button shows a spinner and cannot be clicked again.
    private readonly HashSet<MediaKey> removing = [];
    private bool failed;
    private int userId;
    private IReadOnlyList<MediaSummaryDto> items = [];
    private IReadOnlyList<string> genreOptions = [];
    private IReadOnlyCollection<string> genres = [];
    private IReadOnlyCollection<string> duration = [];
    private IReadOnlyCollection<string> sort = [];

    private bool IsFiltered => genres.Count > 0 || duration.Count > 0;

    [SupplyParameterFromQuery(Name = "type")]
    private string? TypeSlug { get; set; }

    // Anime unless the address asks for movies or series (the type switch of the header sets it).
    private MediaType Type => MediaRoutes.FromSlug(TypeSlug) ?? MediaRoutes.DefaultType;

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        failed = false;
        busy = true;

        try
        {
            userId = await CurrentUser.GetUserIdAsync() ?? throw new InvalidOperationException("Not signed in.");
            genreOptions = await WatchList.GetGenresAsync(userId, Type);
            // A filter on a genre that left the list would hide everything.
            genres = genres.Where(genreOptions.Contains).ToList();
            items = await WatchList.GetAsync(userId, FilterOptions.ToFilter(genres, duration) with { Type = Type }, FilterOptions.ToSort(sort));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "The watchlist could not be loaded.");
            failed = true;
        }
        finally
        {
            loading = false;
            busy = false;
        }
    }

    private async Task OnGenresChanged(IReadOnlyCollection<string> selected)
    {
        genres = selected;
        await ReloadAsync();
    }

    private async Task OnDurationChanged(IReadOnlyCollection<string> selected)
    {
        duration = selected;
        await ReloadAsync();
    }

    private async Task OnSortChanged(IReadOnlyCollection<string> selected)
    {
        sort = selected;
        await ReloadAsync();
    }

    private static MediaKey Key(MediaSummaryDto media) => new(media.Type, media.Id);

    private async Task RemoveAsync(MediaSummaryDto media)
    {
        // A second click while the first is still running would only repeat the request.
        var key = Key(media);
        if (!removing.Add(key))
        {
            return;
        }

        try
        {
            await WatchList.RemoveAsync(userId, media.Type, media.Id);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "{Type} {ExternalId} could not be removed.", media.Type, media.Id);
            failed = true;
            return;
        }
        finally
        {
            removing.Remove(key);
        }

        await ReloadAsync();
    }
}
