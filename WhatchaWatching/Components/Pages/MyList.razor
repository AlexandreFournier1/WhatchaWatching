@page "/my-list"
@attribute [Authorize]
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject ILogger<MyList> Logger
@inject ILocalizer L

<PageTitle>@L["My List"] - WhatchaWatching</PageTitle>

<section class="page-section">
    <header class="page-header">
        <h1>@L["My List"]</h1>
        @if (!loading && !failed)
        {
            <p class="muted fade-in">@(IsFiltered ? L.F("{0} matching", items.Count) : L.F("{0} to watch", items.Count))</p>
            @if (Type == MediaType.Anime)
            {
                <p class="fade-in"><a href="anime/new">@L["Add an anime by hand"]</a></p>
            }
        }
    </header>

    @if (loading)
    {
        <div class="media-grid" aria-busy="true">
            @for (var i = 0; i < 4; i++)
            {
                <MediaCardSkeleton />
            }
        </div>
    }
    else if (failed)
    {
        <EmptyState Title="@L["Your list could not be loaded"]" Message="@L["Try again in a moment."]">
            <button type="button" class="btn" @onclick="ReloadAsync">@L["Try again"]</button>
        </EmptyState>
    }
    else if (items.Count == 0 && !IsFiltered)
    {
        <EmptyState Title="@NoneInList" Message="@L["Search for something and add it to your list."]">
            <a class="btn" href="@MediaRoutes.SearchUrl(Type)">@L["Find something to add"]</a>
        </EmptyState>
    }
    else
    {
        <div class="filters">
            <FilterDropdown Label="@L["Genre"]" Multiple="true" Options="FilterOptions.Plain(genreOptions)" Selected="genres" SelectedChanged="OnGenresChanged" />
            @if (platformOptions.Count > 0)
            {
                <FilterDropdown Label="@L["Platform"]" Multiple="true" Options="FilterOptions.Plain(platformOptions)" Selected="platforms" SelectedChanged="OnPlatformsChanged" />
            }
            <FilterDropdown Label="@L["Duration"]" Options="FilterOptions.Localized(FilterOptions.DurationValues(Type), L)" Selected="duration" SelectedChanged="OnDurationChanged" />
            <FilterDropdown Label="@L["Score"]" Options="FilterOptions.Localized(FilterOptions.ScoreValues, L)" Selected="score" SelectedChanged="OnScoreChanged" />
            <FilterDropdown Label="@L["Released"]" Options="FilterOptions.Localized(FilterOptions.PeriodValues, L)" Selected="period" SelectedChanged="OnPeriodChanged" />
            <FilterDropdown Label="@L["Sort by"]" Options="FilterOptions.Localized(FilterOptions.SortValues, L)" Selected="sort" SelectedChanged="OnSortChanged" />
        </div>

        @if (items.Count == 0)
        {
            <EmptyState Title="@L["No match"]" Message="@L["Nothing in your list matches these filters."]" />
        }
        else
        {
            <div class="media-grid @(busy ? "is-busy" : "")" aria-busy="@(busy ? "true" : "false")">
                @foreach (var anime in items)
                {
                    <MediaCard Media="anime" @key="(anime.Type, anime.Id)">
                        <button type="button" class="btn btn-danger btn-sm" title="@(anime.IsCustom ? L["Remove and delete this anime"] : L["Remove from my list"])"
                                disabled="@removing.Contains(Key(anime))" aria-busy="@(removing.Contains(Key(anime)) ? "true" : "false")"
                                @onclick="() => RemoveAsync(anime)">
                            @if (removing.Contains(Key(anime)))
                            {
                                <span class="spinner" aria-hidden="true"></span><span>@L["Removing..."]</span>
                            }
                            else
                            {
                                <Icon Name="trash" Size="16" /><span>@L["Remove"]</span>
                            }
                        </button>
                    </MediaCard>
                }
            </div>
        }
    }
</section>

@code {
    // Stays true while the page is prerendered: the skeleton is part of the first HTML.
    private bool loading = true;
    private bool busy;

    // Titles being removed: their button shows a spinner and cannot be clicked again.
    private readonly HashSet<MediaKey> removing = [];
    private bool failed;
    private int userId;
    private IReadOnlyList<MediaSummaryDto> items = [];
    private IReadOnlyList<string> genreOptions = [];
    private IReadOnlyList<string> platformOptions = [];
    private IReadOnlyCollection<string> platforms = [];
    private IReadOnlyCollection<string> genres = [];
    private IReadOnlyCollection<string> duration = [];
    private IReadOnlyCollection<string> score = [];
    private IReadOnlyCollection<string> period = [];
    private IReadOnlyCollection<string> sort = [];

    // "None" in the language of the visit: the gender of the word changes in French, so each type has its own phrase.
    private string NoneInList => Type switch
    {
        MediaType.Movie => L["No movies in your list"],
        MediaType.TVShow => L["No TV series in your list"],
        _ => L["No anime in your list"]
    };

    private bool IsFiltered => genres.Count > 0 || platforms.Count > 0 || duration.Count > 0 || score.Count > 0 || period.Count > 0;

    [SupplyParameterFromQuery(Name = "type")]
    private string? TypeSlug { get; set; }

    // Anime unless the address asks for movies or series (the type switch of the header sets it).
    private MediaType Type => MediaRoutes.FromSlug(TypeSlug) ?? MediaRoutes.DefaultType;

    private MediaType? shownType;

    protected override async Task OnParametersSetAsync()
    {
        // The genres and the lengths of another type mean something else: the choices start again.
        if (shownType != Type)
        {
            shownType = Type;
            genres = [];
            platforms = [];
            duration = [];
            score = [];
            period = [];
        }

        if (RendererInfo.IsInteractive)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        failed = false;
        busy = true;

        try
        {
            userId = await CurrentUser.GetUserIdAsync() ?? throw new InvalidOperationException("Not signed in.");
            genreOptions = await WatchList.GetGenresAsync(userId, Type);
            // A filter on a genre that left the list would hide everything.
            genres = genres.Where(genreOptions.Contains).ToList();
            platformOptions = await WatchList.GetPlatformsAsync(userId, Type);
            platforms = platforms.Where(platformOptions.Contains).ToList();
            items = await WatchList.GetAsync(userId, FilterOptions.ToFilter(Type, genres, duration, score, period, platforms), FilterOptions.ToSort(sort));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "The watchlist could not be loaded.");
            failed = true;
        }
        finally
        {
            loading = false;
            busy = false;
        }
    }

    private async Task OnGenresChanged(IReadOnlyCollection<string> selected)
    {
        genres = selected;
        await ReloadAsync();
    }

    private async Task OnPlatformsChanged(IReadOnlyCollection<string> selected)
    {
        platforms = selected;
        await ReloadAsync();
    }

    private async Task OnScoreChanged(IReadOnlyCollection<string> selected)
    {
        score = selected;
        await ReloadAsync();
    }

    private async Task OnPeriodChanged(IReadOnlyCollection<string> selected)
    {
        period = selected;
        await ReloadAsync();
    }

    private async Task OnDurationChanged(IReadOnlyCollection<string> selected)
    {
        duration = selected;
        await ReloadAsync();
    }

    private async Task OnSortChanged(IReadOnlyCollection<string> selected)
    {
        sort = selected;
        await ReloadAsync();
    }

    private static MediaKey Key(MediaSummaryDto media) => new(media.Type, media.Id);

    private async Task RemoveAsync(MediaSummaryDto media)
    {
        // A second click while the first is still running would only repeat the request.
        var key = Key(media);
        if (!removing.Add(key))
        {
            return;
        }

        try
        {
            await WatchList.RemoveAsync(userId, media.Type, media.Id);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "{Type} {ExternalId} could not be removed.", media.Type, media.Id);
            failed = true;
            return;
        }
        finally
        {
            removing.Remove(key);
        }

        await ReloadAsync();
    }
}
