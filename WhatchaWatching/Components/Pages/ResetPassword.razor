@page "/reset-password"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using WhatchaWatching.Infrastructure.Data.Entities
@using WhatchaWatching.Services.Email
@inject UserManager<UserEntity> UserManager

<PageTitle>Choose a new password - WhatchaWatching</PageTitle>

<section class="auth">
    <h1>Choose a new password</h1>

    @if (done)
    {
        <p class="notice" role="status">Your password has changed. Every other session of your account has been signed out.</p>
        <p class="switch"><a href="login">Log in</a></p>
    }
    else if (!LinkLooksValid)
    {
        <p class="validation-message" role="alert">This link is not valid. Ask for a new one.</p>
        <p class="switch"><a href="forgot-password">Send me a new link</a></p>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="password">New password</label>
                <InputText id="password" type="password" class="input" autocomplete="new-password" @bind-Value="Input.Password" />
                <small class="muted">At least 8 characters, including a digit.</small>
                <ValidationMessage For="() => Input.Password" />
            </div>

            <div class="field">
                <label for="confirm">Confirm password</label>
                <InputText id="confirm" type="password" class="input" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>

            @foreach (var message in errors)
            {
                <p class="validation-message" role="alert">@message</p>
            }

            <button type="submit" class="btn">Change my password</button>
        </EditForm>
    }
</section>

@code {
    private bool done;
    private List<string> errors = [];

    [SupplyParameterFromForm]
    private ResetInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private bool LinkLooksValid => !string.IsNullOrWhiteSpace(Email) && TokenCodec.TryDecode(Code, out _);

    protected override void OnInitialized() => Input ??= new();

    private async Task ResetAsync()
    {
        var user = Email is null ? null : await UserManager.FindByEmailAsync(Email);

        // An unknown address and a bad token get the same answer.
        if (user is null || !TokenCodec.TryDecode(Code, out var token))
        {
            errors = ["This link is not valid or has expired. Ask for a new one."];
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (!result.Succeeded)
        {
            errors = result.Errors
                .Select(e => e.Code == nameof(IdentityErrorDescriber.InvalidToken)
                    ? "This link is not valid or has expired. Ask for a new one."
                    : e.Description)
                .Distinct()
                .ToList();
            return;
        }

        // The change also renewed the security stamp, which ends the sessions that were already open. Someone locked
        // out by wrong attempts can log in again right away: they have just proved they own the address.
        await UserManager.SetLockoutEndDateAsync(user, null);
        await UserManager.ResetAccessFailedCountAsync(user);
        done = true;
    }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "Choose a password.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Type the password again.")]
        [Compare(nameof(Password), ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
