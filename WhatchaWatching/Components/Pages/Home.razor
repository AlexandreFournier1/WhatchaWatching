@page "/"
@inject IRandomPickerService Picker
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject IUserSettingsService Settings
@inject AdultFilterState AdultState
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject ILocalizer L

<PageTitle>WhatchaWatching</PageTitle>

<section class="home">
    <h1>@L["Whatcha watching today ?"]</h1>

    <div class="actions">
        <button type="button" class="btn" disabled="@loading" @onclick="Surprise">@L["Surprise Me"]</button>
        <button type="button" class="btn" aria-expanded="@(showConditions ? "true" : "false")"
                @onclick="ToggleConditions">@L["Find me something like..."]</button>
    </div>

    <AdultSwitch Visible="profileAllowsAdult" Value="AdultState.Enabled" ValueChanged="OnAdultChanged" />

    @if (showConditions)
    {
        <div class="conditions fade-in">
            <h2>@L["What's your condition ?"]</h2>

            <div class="filters">
                <FilterDropdown Label="@L["Genre"]" Multiple="true" Options="FilterOptions.Plain(genreOptions)" @bind-Selected="genres" />
                @if (platformOptions.Count > 0)
                {
                    <FilterDropdown Label="@L["Platform"]" Multiple="true" Options="FilterOptions.Plain(platformOptions)" @bind-Selected="platforms" />
                }
                <FilterDropdown Label="@L["Duration"]" Options="FilterOptions.Localized(FilterOptions.DurationValues(Type), L)" @bind-Selected="duration" />
                <FilterDropdown Label="@L["Score"]" Options="FilterOptions.Localized(FilterOptions.ScoreValues, L)" @bind-Selected="score" />
            </div>

            <button type="button" class="btn" disabled="@loading" @onclick="PickWithConditions">@L["Yeah that's it"]</button>
        </div>
    }

    @if (state != State.Idle)
    {
        <div class="result" aria-live="polite" aria-busy="@(state == State.Loading ? "true" : "false")">
            @switch (state)
            {
                case State.Loading:
                    <h2 class="muted fade-in">@L["Looking for something..."]</h2>
                    <MediaCardSkeleton Featured="true" />
                    break;

                case State.NeedsLogin:
                    <EmptyState Title="@L["Log in to use your list"]" Message="@L["The picker chooses among the titles of your list."]">
                        <a class="btn" href="@Navigation.GetLoginUrl()">@L["Log in"]</a>
                    </EmptyState>
                    break;

                case State.Failed:
                    <EmptyState Title="@L["Something went wrong"]" Message="@L["Your list could not be read. Try again in a moment."]">
                        <button type="button" class="btn" @onclick="Pick">@L["Try again"]</button>
                    </EmptyState>
                    break;

                case State.Nothing:
                    <EmptyState Title="@L["Nothing to pick from"]"
                                Message="@L["Your list has nothing matching this. Add some titles, or change the conditions."]">
                        <a class="btn" href="@MediaRoutes.SearchUrl(Type)">@L["Find something to add"]</a>
                    </EmptyState>
                    break;

                case State.Picked when pick is not null:
                    <h2 class="fade-in">@L["Today you will be watching this :"]</h2>

                    <MediaCard Media="pick" Featured="true">
                        <a class="btn btn-ghost" href="@MediaRoutes.DetailUrl(pick.Type, pick.Id)">@L["View details"]</a>
                        <button type="button" class="btn btn-ghost" @onclick="Pick">@L["Pick another"]</button>
                    </MediaCard>
                    break;
            }
        </div>
    }
</section>

@code {
    private enum State { Idle, Loading, Picked, Nothing, NeedsLogin, Failed }

    private State state = State.Idle;
    private bool showConditions;
    private bool profileAllowsAdult;
    private bool loading => state == State.Loading;
    private MediaSummaryDto? pick;
    private IReadOnlyList<string> genreOptions = [];
    private IReadOnlyList<string> platformOptions = [];
    private IReadOnlyCollection<string> platforms = [];
    private IReadOnlyCollection<string> genres = [];
    private IReadOnlyCollection<string> duration = [];
    private IReadOnlyCollection<string> score = [];

    [SupplyParameterFromQuery(Name = "type")]
    private string? TypeSlug { get; set; }

    // Anime unless the address asks for movies or series (the type switch of the header sets it).
    private MediaType Type => MediaRoutes.FromSlug(TypeSlug) ?? MediaRoutes.DefaultType;

    private MediaType? shownType;

    protected override async Task OnParametersSetAsync()
    {
        // Another type is another list: the previous pick and the genres chosen for it no longer apply.
        if (shownType != Type)
        {
            shownType = Type;
            state = State.Idle;
            pick = null;
            genres = [];
            duration = [];
            score = [];
            genreOptions = [];
            platformOptions = [];
            platforms = [];

            if (showConditions)
            {
                await LoadGenresAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The switch only exists for someone whose profile allows adult content. Nothing to read while prerendering.
        if (RendererInfo.IsInteractive && await CurrentUser.GetUserIdAsync() is { } userId)
        {
            try
            {
                profileAllowsAdult = await Settings.ShowsAdultContentAsync(userId);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Without the switch the pick still works, with the profile's own setting.
                Logger.LogError(ex, "The adult content setting could not be read.");
            }
        }
    }

    private void OnAdultChanged(bool enabled) => AdultState.Enabled = enabled;

    private async Task Surprise()
    {
        showConditions = false;
        genres = [];
        duration = [];
        score = [];
        platforms = [];
        await Pick();
    }

    private async Task ToggleConditions()
    {
        showConditions = !showConditions;
        state = State.Idle;
        pick = null;

        if (showConditions)
        {
            await LoadGenresAsync();
        }
    }

    private Task PickWithConditions() => Pick();

    private async Task LoadGenresAsync()
    {
        try
        {
            if (await CurrentUser.GetUserIdAsync() is { } userId)
            {
                genreOptions = await WatchList.GetGenresAsync(userId, Type);
                platformOptions = await WatchList.GetPlatformsAsync(userId, Type);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The picker will report the problem when it is used.
            Logger.LogError(ex, "The genres of the watchlist could not be read.");
        }
    }

    private async Task Pick()
    {
        if (loading)
        {
            return;
        }

        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null)
        {
            state = State.NeedsLogin;
            return;
        }

        state = State.Loading;
        try
        {
            // The switch can only hide adult titles: the service shows them only if the profile allows it too.
            var filter = FilterOptions.ToFilter(Type, genres, duration, score, platforms: platforms) with { IncludeAdult = AdultState.Enabled };
            pick = await Picker.PickAsync(userId.Value, filter, pick is null ? null : new MediaKey(pick.Type, pick.Id));
            state = pick is null ? State.Nothing : State.Picked;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "The random pick failed.");
            pick = null;
            state = State.Failed;
        }
    }
}
