@page "/"
@inject IRandomPickerService Picker
@inject IWatchListService WatchList
@inject ICurrentUser CurrentUser
@inject IUserSettingsService Settings
@inject AdultFilterState AdultState
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>WhatchaWatching</PageTitle>

<section class="home">
    <h1>Whatcha watching today ?</h1>

    <div class="actions">
        <button type="button" class="btn" disabled="@loading" @onclick="Surprise">Surprise Me</button>
        <button type="button" class="btn" aria-expanded="@(showConditions ? "true" : "false")"
                @onclick="ToggleConditions">Find me something like...</button>
    </div>

    <AdultSwitch Visible="profileAllowsAdult" Value="AdultState.Enabled" ValueChanged="OnAdultChanged" />

    @if (showConditions)
    {
        <div class="conditions fade-in">
            <h2>What's your condition ?</h2>

            <div class="filters">
                <FilterDropdown Label="Genre" Multiple="true" Options="genreOptions" @bind-Selected="genres" />
                <FilterDropdown Label="Duration" Options="FilterOptions.DurationLabels" @bind-Selected="duration" />
            </div>

            <button type="button" class="btn" disabled="@loading" @onclick="PickWithConditions">Yeah that's it</button>
        </div>
    }

    @if (state != State.Idle)
    {
        <div class="result" aria-live="polite" aria-busy="@(state == State.Loading ? "true" : "false")">
            @switch (state)
            {
                case State.Loading:
                    <h2 class="muted fade-in">Looking for something...</h2>
                    <AnimeCardSkeleton Featured="true" />
                    break;

                case State.NeedsLogin:
                    <EmptyState Title="Log in to use your list" Message="The picker chooses among the anime of your list.">
                        <a class="btn" href="@Navigation.GetLoginUrl()">Log in</a>
                    </EmptyState>
                    break;

                case State.Failed:
                    <EmptyState Title="Something went wrong" Message="Your list could not be read. Try again in a moment.">
                        <button type="button" class="btn" @onclick="Pick">Try again</button>
                    </EmptyState>
                    break;

                case State.Nothing:
                    <EmptyState Title="Nothing to pick from"
                                Message="Your list has no anime matching this. Add some, or change the conditions.">
                        <a class="btn" href="search">Find something to add</a>
                    </EmptyState>
                    break;

                case State.Picked when pick is not null:
                    <h2 class="fade-in">Today you will be watching this :</h2>

                    <AnimeCard Anime="pick" Featured="true">
                        <a class="btn btn-ghost" href="anime/@pick.Id">View details</a>
                        <button type="button" class="btn btn-ghost" @onclick="Pick">Pick another</button>
                    </AnimeCard>
                    break;
            }
        </div>
    }
</section>

@code {
    private enum State { Idle, Loading, Picked, Nothing, NeedsLogin, Failed }

    private State state = State.Idle;
    private bool showConditions;
    private bool profileAllowsAdult;
    private bool loading => state == State.Loading;
    private AnimeSummaryDto? pick;
    private IReadOnlyList<string> genreOptions = [];
    private IReadOnlyCollection<string> genres = [];
    private IReadOnlyCollection<string> duration = [];

    protected override async Task OnInitializedAsync()
    {
        // The switch only exists for someone whose profile allows adult content. Nothing to read while prerendering.
        if (RendererInfo.IsInteractive && await CurrentUser.GetUserIdAsync() is { } userId)
        {
            try
            {
                profileAllowsAdult = await Settings.ShowsAdultContentAsync(userId);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Without the switch the pick still works, with the profile's own setting.
                Logger.LogError(ex, "The adult content setting could not be read.");
            }
        }
    }

    private void OnAdultChanged(bool enabled) => AdultState.Enabled = enabled;

    private async Task Surprise()
    {
        showConditions = false;
        genres = [];
        duration = [];
        await Pick();
    }

    private async Task ToggleConditions()
    {
        showConditions = !showConditions;
        state = State.Idle;
        pick = null;

        if (showConditions)
        {
            await LoadGenresAsync();
        }
    }

    private Task PickWithConditions() => Pick();

    private async Task LoadGenresAsync()
    {
        try
        {
            if (await CurrentUser.GetUserIdAsync() is { } userId)
            {
                genreOptions = await WatchList.GetGenresAsync(userId);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The picker will report the problem when it is used.
            Logger.LogError(ex, "The genres of the watchlist could not be read.");
        }
    }

    private async Task Pick()
    {
        if (loading)
        {
            return;
        }

        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null)
        {
            state = State.NeedsLogin;
            return;
        }

        state = State.Loading;
        try
        {
            // The switch can only hide adult anime: the service shows them only if the profile allows it too.
            var filter = FilterOptions.ToFilter(genres, duration) with { IncludeAdult = AdultState.Enabled };
            pick = await Picker.PickAsync(userId.Value, filter, pick?.Id);
            state = pick is null ? State.Nothing : State.Picked;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "The random pick failed.");
            pick = null;
            state = State.Failed;
        }
    }
}
