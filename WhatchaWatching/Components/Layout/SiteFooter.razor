@using WhatchaWatching.Services

<footer class="footer">
    <div class="footer-inner">
        <div class="credits">
            <span class="name">WhatchaWatching</span>
            <span>Made by Alexandre Fournier &middot; &copy; @DateTime.UtcNow.Year &middot; <a href="privacy">Privacy</a></span>
        </div>

        <div class="data">
            <span>
                Anime data from
                <a href="https://jikan.moe/" target="_blank" rel="noopener noreferrer">Jikan</a> (MyAnimeList)
                and <a href="https://anilist.co/" target="_blank" rel="noopener noreferrer">AniList</a>
            </span>
            <span>
                Movie and TV data from
                <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">TMDB</a>,
                streaming availability by
                <a href="https://www.justwatch.com/" target="_blank" rel="noopener noreferrer">JustWatch</a>
            </span>
            <a class="tmdb-logo" href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">
                <img src="tmdb-logo.png" alt="TMDB" width="62" height="28" loading="lazy" />
            </a>
            <span class="small-print">This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
            @if (AppVersion.Display.Length > 0)
            {
                <span class="version" title="Version of the site and commit it was built from">@AppVersion.Display</span>
            }
        </div>
    </div>
</footer>
