@inject NavigationManager Navigation

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="">WhatchaWatching</a>

        <button type="button" class="icon-button menu-toggle" aria-label="Toggle navigation"
                aria-expanded="@(menuOpen ? "true" : "false")" @onclick="ToggleMenu">
            <Icon Name="@(menuOpen ? "x" : "menu")" />
        </button>

        <nav class="links @(menuOpen ? "open" : "")" aria-label="Main">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseAll">Home</NavLink>
            <NavLink class="nav-link" href="my-list" @onclick="CloseAll">My List</NavLink>
        </nav>

        <form class="search" role="search" @onsubmit="Search">
            <Icon Name="search" Size="16" />
            <input type="search" placeholder="Search something..." aria-label="Search anime"
                   @bind="query" @bind:event="oninput" />
        </form>

        <div class="user">
            <button type="button" class="icon-button avatar" aria-label="User menu"
                    aria-expanded="@(userOpen ? "true" : "false")" @onclick="ToggleUser">
                <Icon Name="user" />
            </button>

            @if (userOpen)
            {
                <div class="backdrop" @onclick="CloseAll"></div>
                <div class="user-menu pop-in">
                    <a href="login" @onclick="CloseAll">Log in</a>
                    <a href="register" @onclick="CloseAll">Create account</a>
                    <a href="account" @onclick="CloseAll">My account</a>
                </div>
            }
        </div>
    </div>
</header>

@code {
    private string query = string.Empty;
    private bool menuOpen;
    private bool userOpen;

    private void ToggleMenu()
    {
        userOpen = false;
        menuOpen = !menuOpen;
    }

    private void ToggleUser()
    {
        menuOpen = false;
        userOpen = !userOpen;
    }

    private void CloseAll()
    {
        menuOpen = false;
        userOpen = false;
    }

    private void Search()
    {
        var term = query.Trim();
        if (term.Length == 0)
        {
            return;
        }

        CloseAll();
        Navigation.NavigateTo($"search?q={Uri.EscapeDataString(term)}");
    }
}
