<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="">WhatchaWatching</a>

        @* Nothing here needs the circuit: the login and register pages are rendered by the server, with this same bar. *@
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />
        <label for="nav-toggle" class="icon-button menu-toggle">
            <Icon Name="menu" />
        </label>

        <nav class="links" aria-label="Main">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="nav-link" href="my-list">My List</NavLink>
        </nav>

        <form class="search" role="search" action="search" method="get">
            <Icon Name="search" Size="16" />
            <input type="search" name="q" placeholder="Search something..." aria-label="Search anime, movies and TV series" required />
        </form>

        <details class="user">
            <summary class="icon-button avatar" aria-label="User menu">
                <Icon Name="user" />
            </summary>

            <div class="user-menu pop-in">
                <AuthorizeView>
                    <Authorized>
                        <p class="signed-in">@context.User.Identity?.Name</p>
                        <a href="account">My account</a>
                        <form method="post" action="logout">
                            <AntiforgeryToken />
                            <button type="submit">Log out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login">Log in</a>
                        <a href="register">Create account</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </details>
    </div>
</header>
