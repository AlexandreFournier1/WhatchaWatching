@implements IDisposable
@inject NavigationManager Navigation

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="@Link("")">WhatchaWatching</a>

        @* Nothing here needs the circuit: the login and register pages are rendered by the server, with this same bar. *@
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />
        <label for="nav-toggle" class="icon-button menu-toggle">
            <Icon Name="menu" />
        </label>

        @* One switch for the whole site: the pages, the links below and the search all follow the type it shows. *@
        @if (MediaRoutes.FollowsType(Path))
        {
            <MediaTypeTabs />
        }

        <nav class="links" aria-label="Main">
            <a class="nav-link @(Path == "" ? "active" : "")" href="@Link("")">Home</a>
            <a class="nav-link @(Path == "my-list" ? "active" : "")" href="@Link("my-list")">My List</a>
        </nav>

        <form class="search" role="search" action="search" method="get">
            <Icon Name="search" Size="16" />
            <input type="hidden" name="type" value="@MediaRoutes.Slug(Type)" />
            <input type="search" name="q" placeholder="@($"Search {MediaRoutes.Label(Type).ToLowerInvariant()}...")" aria-label="@($"Search {MediaRoutes.Label(Type).ToLowerInvariant()}")" required />
        </form>

        <details class="user">
            <summary class="icon-button avatar" aria-label="User menu">
                <Icon Name="user" />
            </summary>

            <div class="user-menu pop-in">
                <AuthorizeView>
                    <Authorized>
                        <p class="signed-in">@context.User.Identity?.Name</p>
                        <a href="account">My account</a>
                        <form method="post" action="logout">
                            <AntiforgeryToken />
                            <button type="submit">Log out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login">Log in</a>
                        <a href="register">Create account</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </details>
    </div>
</header>

@code {
    private string Address => Navigation.ToBaseRelativePath(Navigation.Uri);

    private string Path => MediaRoutes.PathOf(Address);

    // The type of the page being shown, which the links and the search of the bar keep.
    private MediaType Type => MediaRoutes.FromAddress(Address);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    // The bar belongs to the layout, which stays when the page changes: it has to follow the address itself.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    // The default type needs no mark in the address.
    private string Link(string path)
    {
        var target = path.Length == 0 ? "./" : path;

        return Type == MediaRoutes.DefaultType ? target : $"{target}?type={MediaRoutes.Slug(Type)}";
    }
}
