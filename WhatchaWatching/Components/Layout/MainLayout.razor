@inherits LayoutComponentBase
@inject ILocalizer L

<a class="skip-link" href="#main">@L["Skip to content"]</a>

<div class="shell">
    <NavMenu />

    <main id="main" class="shell-content" tabindex="-1">
        @Body
    </main>

    <SiteFooter />
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["An unhandled error has occurred."]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">X</span>
</div>
