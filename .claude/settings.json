{
  "permissions": {
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet ef migrations add *)",
      "Bash(dotnet ef migrations list *)",
      "Bash(dotnet ef migrations script *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Bash(dotnet ef database update*)",
      "Bash(dotnet ef database drop*)",
      "Bash(dotnet user-secrets list*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git push*--no-verify*)",
      "Read(**/appsettings.Production*.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-secrets.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/build-after-edit.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
